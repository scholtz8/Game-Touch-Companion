<Window x:Class="GameTouchCompanion.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GameTouchCompanion.App"
        Title="{local:Tr Ui000}" Icon="Assets/GameTouchCompanion.ico" Height="800" Width="900" MinHeight="620" MinWidth="740"
        Background="{Binding ConfigurationBackground, Source={x:Static local:Appearance.Current}}"
        Foreground="{Binding ConfigurationForeground, Source={x:Static local:Appearance.Current}}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{Binding ConfigurationForeground, Source={x:Static local:Appearance.Current}}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{Binding ConfigurationControl, Source={x:Static local:Appearance.Current}}"/>
            <Setter Property="Foreground" Value="{Binding ConfigurationForeground, Source={x:Static local:Appearance.Current}}"/>
            <Setter Property="BorderBrush" Value="{Binding ConfigurationBorder, Source={x:Static local:Appearance.Current}}"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{Binding ConfigurationForeground, Source={x:Static local:Appearance.Current}}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{Binding ConfigurationForeground, Source={x:Static local:Appearance.Current}}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.7"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.65"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Label"><Setter Property="Foreground" Value="{Binding ConfigurationForeground, Source={x:Static local:Appearance.Current}}"/></Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{Binding ConfigurationControl, Source={x:Static local:Appearance.Current}}"/>
            <Setter Property="Foreground" Value="{Binding ConfigurationForeground, Source={x:Static local:Appearance.Current}}"/>
            <Setter Property="BorderBrush" Value="{Binding ConfigurationBorder, Source={x:Static local:Appearance.Current}}"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{Binding ConfigurationControl, Source={x:Static local:Appearance.Current}}"/>
            <Setter Property="Foreground" Value="{Binding ConfigurationForeground, Source={x:Static local:Appearance.Current}}"/>
            <Setter Property="BorderBrush" Value="{Binding ConfigurationBorder, Source={x:Static local:Appearance.Current}}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="Stretch" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <Grid Margin="{TemplateBinding Padding}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
                                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" VerticalAlignment="Center"/>
                                    <Path Grid.Column="1" Margin="5,0,0,0" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}"
                                          Data="M 0 0 L 8 0 L 4 5 Z"/>
                                </Grid>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                    <ScrollViewer MaxHeight="260" CanContentScroll="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{Binding ConfigurationControl, Source={x:Static local:Appearance.Current}}"/>
            <Setter Property="Foreground" Value="{Binding ConfigurationForeground, Source={x:Static local:Appearance.Current}}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemSurface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="{Binding ConfigurationSurface, Source={x:Static local:Appearance.Current}}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="{Binding ConfigurationSurface, Source={x:Static local:Appearance.Current}}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{Binding ConfigurationForeground, Source={x:Static local:Appearance.Current}}"/></Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{Binding ConfigurationControl, Source={x:Static local:Appearance.Current}}"/>
            <Setter Property="Foreground" Value="{Binding ConfigurationForeground, Source={x:Static local:Appearance.Current}}"/>
            <Setter Property="BorderBrush" Value="{Binding ConfigurationBorder, Source={x:Static local:Appearance.Current}}"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{Binding ConfigurationForeground, Source={x:Static local:Appearance.Current}}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Item" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="6">
                    <ContentPresenter/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="{Binding ConfigurationSurface, Source={x:Static local:Appearance.Current}}"/><Setter TargetName="Item" Property="BorderBrush" Value="{Binding ConfigurationForeground, Source={x:Static local:Appearance.Current}}"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Item" Property="BorderBrush" Value="{Binding ConfigurationForeground, Source={x:Static local:Appearance.Current}}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="Border">
            <Setter Property="Background" Value="{Binding ConfigurationSurface, Source={x:Static local:Appearance.Current}}"/>
            <Setter Property="BorderBrush" Value="{Binding ConfigurationBorder, Source={x:Static local:Appearance.Current}}"/>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{Binding ConfigurationBackground, Source={x:Static local:Appearance.Current}}"/>
            <Setter Property="Foreground" Value="{Binding ConfigurationForeground, Source={x:Static local:Appearance.Current}}"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{Binding ConfigurationForeground, Source={x:Static local:Appearance.Current}}"/>
            <Setter Property="Background" Value="{Binding ConfigurationControl, Source={x:Static local:Appearance.Current}}"/>
            <Setter Property="BorderBrush" Value="{Binding ConfigurationBorder, Source={x:Static local:Appearance.Current}}"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,1,1,0" CornerRadius="5,5,0,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="{Binding ConfigurationSurface, Source={x:Static local:Appearance.Current}}"/>
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="{Binding ConfigurationForeground, Source={x:Static local:Appearance.Current}}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Opacity" Value="0.82"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="TabSurface" Property="Opacity" Value="0.62"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <TabControl x:Name="ConfigurationTabs" Margin="16" SelectionChanged="ConfigurationTabs_SelectionChanged">
      <TabItem x:Name="SetupTab" Header="{local:Tr Ui001}">
          <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24">
              <TextBlock Text="{local:Tr Ui002}" FontSize="28" FontWeight="SemiBold"/>
              <TextBlock Text="{local:Tr Ui003}" Margin="0,8,0,20" Foreground="{Binding ConfigurationSecondaryForeground, Source={x:Static local:Appearance.Current}}"/>
              <TextBlock Text="{local:Tr Message009}" FontSize="22" FontWeight="SemiBold"/>
              <TextBlock Text="{local:Tr GuideScreens}" TextWrapping="Wrap" Margin="0,8"/>
              <Button Content="{local:Tr Ui004}" Tag="ScreensTab" Click="GoToTab_Click" HorizontalAlignment="Left" Padding="16,8"/>
              <TextBlock Text="{local:Tr Message010}" FontSize="22" FontWeight="SemiBold" Margin="0,18,0,0"/>
              <TextBlock Text="{local:Tr Dynamic121}" TextWrapping="Wrap" Margin="0,8"/>
              <WrapPanel>
                  <Button Content="{local:Tr Ui005}" Tag="BrowserTab" Click="GoToTab_Click" Padding="16,8" Margin="0,0,8,0"/>
                  <Button Content="{local:Tr Ui006}" Tag="ProfilesTab" Click="GoToTab_Click" Padding="16,8"/>
              </WrapPanel>
              <TextBlock Text="{local:Tr Message011}" FontSize="22" FontWeight="SemiBold" Margin="0,18,0,0"/>
              <TextBlock Text="{local:Tr GuidePlay}" TextWrapping="Wrap" Margin="0,8"/>
              <Button Content="{local:Tr Ui023}" Tag="DetectionTab" Click="GoToTab_Click" HorizontalAlignment="Left" Padding="16,8"/>
              <TextBlock x:Name="SetupSummary" Visibility="Collapsed" TextWrapping="Wrap"/>
          </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem x:Name="ScreensTab" Header="{local:Tr Ui004}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
      <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="{local:Tr Ui011}"/>
            <TextBlock Margin="0,8,0,0" Text="{local:Tr Ui012}"/>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,20,0,0" Padding="18" CornerRadius="8" Background="{Binding ConfigurationSurface, Source={x:Static local:Appearance.Current}}">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="{local:Tr Ui013}"/>
                <TextBlock x:Name="RuntimeStatus" Visibility="Collapsed" Text="{local:Tr Ui014}"/>
                <TextBlock Text="{local:Tr Ui015}" TextWrapping="Wrap" Margin="0,16,0,8"/>
                <Canvas x:Name="MonitorPreviewCanvas" Height="210" Background="{Binding ConfigurationControl, Source={x:Static local:Appearance.Current}}" ClipToBounds="True" SizeChanged="MonitorPreview_SizeChanged"/>
                <TextBlock x:Name="MonitorPreviewLegend" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Margin="0,16,0,0" Padding="18" CornerRadius="8" BorderBrush="{Binding ConfigurationBorder, Source={x:Static local:Appearance.Current}}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock VerticalAlignment="Center" Text="{local:Tr Ui016}"/>
                <ComboBox x:Name="GameMonitorCombo" Grid.Column="1" MinHeight="38" ItemTemplate="{local:MonitorTemplate}"
                          ItemsSource="{Binding Monitors}" SelectedItem="{Binding SelectedGameMonitor, Mode=OneWay}"
                          SelectionChanged="MonitorSelection_Changed"/>

                <TextBlock Grid.Row="1" Margin="0,14,0,0" VerticalAlignment="Center" Text="{local:Tr Ui017}"/>
                <ComboBox x:Name="CompanionMonitorCombo" Grid.Row="1" Grid.Column="1" Margin="0,14,0,0" MinHeight="38"
                          ItemTemplate="{local:MonitorTemplate}" ItemsSource="{Binding Monitors}"
                          SelectedItem="{Binding SelectedCompanionMonitor, Mode=OneWay}" SelectionChanged="MonitorSelection_Changed"/>

                <CheckBox x:Name="AllowSameMonitorCheck" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,16,0,0"
                          IsChecked="{Binding AllowSameMonitorForTesting, Mode=OneWay}"
                          Checked="MonitorSelection_Changed" Unchecked="MonitorSelection_Changed"
                          Content="{local:Tr Ui018}"/>

                <Button Grid.Row="3" Grid.Column="1" Margin="0,16,0,0" Width="150" Height="36" HorizontalAlignment="Left"
                        Click="RefreshMonitors_Click" Content="{local:Tr Ui019}"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,16">
            <TextBlock x:Name="MonitorStatus" Visibility="Collapsed" TextWrapping="Wrap" Text="{Binding MonitorStatus}"/>
            <Border Padding="14" Background="{Binding ConfigurationError, Source={x:Static local:Appearance.Current}}" BorderBrush="#FFDC2626" BorderThickness="1" CornerRadius="6"
                    Visibility="{Binding HasMonitorError, Converter={StaticResource BooleanToVisibility}}">
                <TextBlock Text="{Binding MonitorError}" Foreground="{Binding ConfigurationErrorForeground, Source={x:Static local:Appearance.Current}}" TextWrapping="Wrap"/>
            </Border>
            <Border Margin="0,12,0,0" Padding="16" Background="{Binding ConfigurationError, Source={x:Static local:Appearance.Current}}" BorderBrush="#FFDC2626" BorderThickness="2" CornerRadius="6"
                    Visibility="{Binding IsSelectionReviewRequired, Converter={StaticResource BooleanToVisibility}}">
                <StackPanel>
                    <TextBlock FontWeight="Bold" Foreground="{Binding ConfigurationErrorForeground, Source={x:Static local:Appearance.Current}}" Text="{local:Tr Ui020}"/>
                    <TextBlock Margin="0,8,0,12" TextWrapping="Wrap" Text="{Binding SelectionReviewMessage}"/>
                    <Button Width="190" Height="38" HorizontalAlignment="Left" Click="ConfirmSelectionReview_Click"
                            Content="{local:Tr Ui021}"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <Button x:Name="OpenCompanionButton" Grid.Row="4" Width="240" Height="46" HorizontalAlignment="Left"
                IsEnabled="{Binding CanOpenCompanion}" Click="OpenCompanion_Click" Content="{local:Tr Ui022}"/>
      </Grid>
      </ScrollViewer>
      </TabItem>
      <TabItem x:Name="BrowserTab" Header="{local:Tr Ui005}">
          <local:BrowserSettingsPanel x:Name="BrowserPanel" OpenCompanionRequested="BrowserPanel_OpenCompanionRequested"/>
      </TabItem>
      <TabItem x:Name="ProfilesTab" Header="{local:Tr Ui006}"><local:ProfilesPanel x:Name="GameProfilesPanel"/></TabItem>
      <TabItem x:Name="DetectionTab" Header="{local:Tr Ui023}">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="24">
                  <TextBlock Text="{local:Tr Ui024}" FontSize="26" FontWeight="SemiBold"/>
                  <TextBlock Text="{local:Tr Ui025}" TextWrapping="Wrap" Margin="0,12"/>
                  <CheckBox x:Name="DetectionEnabledCheck" Content="{local:Tr Ui026}"
                            Checked="DetectionEnabled_Changed" Unchecked="DetectionEnabled_Changed" Margin="0,10"/>
                  <Button Content="{local:Tr Ui027}" Click="RearmDetection_Click" HorizontalAlignment="Left" Padding="14,10" Margin="0,10"/>
                  <TextBlock Text="{local:Tr Ui028}" TextWrapping="Wrap" Margin="0,10"/>
                  <TextBlock x:Name="DetectionStatus" Visibility="Collapsed" Text="{local:Tr Ui029}" TextWrapping="Wrap"/>
                  <TextBlock x:Name="DetectedGameText" Text="{local:Tr Ui030}" TextWrapping="Wrap" Margin="0,10"/>
                  <TextBlock x:Name="DetectionDiagnostics" TextWrapping="Wrap" Margin="0,10"/>
                  <TextBlock x:Name="DetectionNotice" Visibility="Collapsed" Text="{local:Tr Ui031}" TextWrapping="Wrap"/>
                  <Border x:Name="DetectionErrorPanel" Visibility="Collapsed" Background="{Binding ConfigurationError, Source={x:Static local:Appearance.Current}}"
                          BorderBrush="#FFDC2626" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,8,0,12">
                      <TextBlock x:Name="DetectionErrorText" Foreground="{Binding ConfigurationErrorForeground, Source={x:Static local:Appearance.Current}}" TextWrapping="Wrap"/>
                  </Border>
                  <TextBlock Text="{local:Tr Ui032}" TextWrapping="Wrap" Foreground="{Binding ConfigurationSecondaryForeground, Source={x:Static local:Appearance.Current}}"/>
              </StackPanel>
          </ScrollViewer>
      </TabItem>
      <TabItem x:Name="SettingsTab" Header="{local:Tr Ui033}">
          <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24">
              <Border x:Name="SettingsErrorPanel" Visibility="Collapsed" Background="{Binding ConfigurationError, Source={x:Static local:Appearance.Current}}"
                      BorderBrush="#FFDC2626" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                  <TextBlock x:Name="SettingsErrorText" Foreground="{Binding ConfigurationErrorForeground, Source={x:Static local:Appearance.Current}}" TextWrapping="Wrap"/>
              </Border>
              <TextBlock Text="{local:Tr LanguageHeading}" FontSize="20" FontWeight="SemiBold"/>
              <ComboBox x:Name="LanguageCombo" SelectedValuePath="Tag" SelectedIndex="0" MinHeight="36" Margin="0,10">
                  <ComboBoxItem Content="Español" Tag="es"/>
                  <ComboBoxItem Content="English" Tag="en"/>
              </ComboBox>
              <Button x:Name="SaveLanguageButton" Content="{local:Tr LanguageApply}" Click="SaveLanguage_Click" HorizontalAlignment="Left" Padding="14,8"/>
              <TextBlock Text="{local:Tr LanguageHelp}" TextWrapping="Wrap" Margin="0,8"/>
              <TextBlock x:Name="LanguageStatus" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,8"/>
              <TextBlock Text="{local:Tr Ui034}" FontSize="26" FontWeight="SemiBold"/>
              <TextBlock Text="{local:Tr Ui035}" FontSize="20" Margin="0,20,0,8"/>
              <TextBlock Text="{local:Tr Ui036}" TextWrapping="Wrap"/>
              <TextBlock Text="{local:Tr Ui037}" TextWrapping="Wrap" Margin="0,12"/>
              <CheckBox x:Name="StartupDetectionCheck" Content="{local:Tr Ui038}"
                        IsChecked="{Binding EnableDetectionOnStartup, Mode=OneWay}" IsEnabled="{Binding SettingsLoaded}"
                        Click="StartupDetection_Click" Margin="0,12"/>
              <TextBlock Text="{local:Tr Ui039}" TextWrapping="Wrap" Foreground="{Binding ConfigurationSecondaryForeground, Source={x:Static local:Appearance.Current}}"/>
              <TextBlock x:Name="StartupPreferenceStatus" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,8"/>
              <TextBlock Text="{local:Tr Ui040}" FontSize="20" FontWeight="SemiBold" Margin="0,18,0,8"/>
              <CheckBox x:Name="WindowsStartupCheck" Content="{local:Tr Ui041}"
                        Click="WindowsStartup_Click" Margin="0,8"/>
              <TextBlock x:Name="WindowsStartupStatus" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,6"/>
              <TextBlock Text="{local:Tr Ui042}" TextWrapping="Wrap" Foreground="{Binding ConfigurationSecondaryForeground, Source={x:Static local:Appearance.Current}}"/>
              <WrapPanel Margin="0,8">
                  <Button x:Name="RegisterCurrentCopyButton" Content="{local:Tr Ui043}" Click="RegisterCurrentCopy_Click" Padding="12,8" Margin="0,0,8,8"/>
                  <Button Content="{local:Tr Ui044}" Click="RefreshStartup_Click" Padding="12,8" Margin="0,0,8,8"/>
              </WrapPanel>
              <CheckBox x:Name="StartInTrayCheck" Content="{local:Tr Ui045}"
                        IsChecked="{Binding StartMinimizedToTray, Mode=OneWay}" IsEnabled="{Binding SettingsLoaded}" Click="TrayPreferences_Click" Margin="0,8"/>
              <CheckBox x:Name="CloseToTrayCheck" Content="{local:Tr Ui046}"
                        IsChecked="{Binding CloseToTray, Mode=OneWay}" IsEnabled="{Binding SettingsLoaded}" Click="TrayPreferences_Click" Margin="0,8"/>
              <TextBlock x:Name="TrayStatus" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,8"/>
              <WrapPanel Margin="0,8">
                  <Button Content="{local:Tr Ui047}" Click="HideToTray_Click" Padding="12,8" Margin="0,0,8,8"/>
                  <Button Content="{local:Tr Ui048}" Click="ExitCompletely_Click" Padding="12,8" Margin="0,0,8,8"/>
              </WrapPanel>
              <TextBlock Text="{local:Tr Ui049}" TextWrapping="Wrap" Foreground="{Binding ConfigurationSecondaryForeground, Source={x:Static local:Appearance.Current}}" Margin="0,8"/>
              <StackPanel x:Name="BrowserPreferences">
                  <CheckBox x:Name="SettingsToolbarCheck" Content="{local:Tr Ui050}" IsEnabled="{Binding CanEditSettings}"
                            IsChecked="{Binding ShowToolbar, Mode=OneWay}" Click="SettingsToolbar_Click" Margin="0,12"/>
                  <TextBlock Text="{Binding SettingsError}" TextWrapping="Wrap" Foreground="{Binding ConfigurationErrorForeground, Source={x:Static local:Appearance.Current}}"/>
              </StackPanel>
              <WrapPanel Margin="0,16">
                  <Button Content="{local:Tr Ui051}" Tag="ScreensTab" Click="GoToTab_Click" Padding="14,10" Margin="0,0,8,8"/>
                  <Button Content="{local:Tr Ui052}" Tag="BrowserTab" Click="GoToTab_Click" Padding="14,10" Margin="0,0,8,8"/>
                  <Button Content="{local:Tr Ui053}" Tag="DetectionTab" Click="GoToTab_Click" Padding="14,10" Margin="0,0,8,8"/>
              </WrapPanel>
              <TextBlock Text="{local:Tr Ui054}" TextWrapping="Wrap" Margin="0,12"/>
              <TextBlock Text="{local:Tr Ui055}" TextWrapping="Wrap"/>
          </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem x:Name="AppearanceTab" Header="{local:Tr AppearanceTitle}"><local:AppearancePanel x:Name="CustomizationPanel"/></TabItem>
      <TabItem x:Name="DiagnosticsTab" Header="{local:Tr Ui056}">
          <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24">
              <TextBlock Text="{local:Tr Ui057}" FontSize="26" FontWeight="SemiBold"/>
              <TextBlock x:Name="DiagnosticsEnvironment" TextWrapping="Wrap" Margin="0,16"/>
              <TextBlock Text="{Binding Text, ElementName=RuntimeStatus}" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding MonitorStatus}" TextWrapping="Wrap" Margin="0,12"/>
              <TextBlock Text="{Binding SelectionReviewMessage}" TextWrapping="Wrap" Foreground="{Binding ConfigurationErrorForeground, Source={x:Static local:Appearance.Current}}"/>
              <TextBlock x:Name="DiagnosticsSnapshot" TextWrapping="Wrap" Margin="0,12"/>
              <WrapPanel>
                  <Button Content="{local:Tr Ui058}" Click="RefreshDiagnostics_Click" HorizontalAlignment="Left" Padding="14,10" Margin="0,0,8,0"/>
                  <Button Content="{local:Tr Ui162}" Click="OpenLogs_Click" HorizontalAlignment="Left" Padding="14,10"/>
              </WrapPanel>
              <TextBlock Text="{local:Tr Ui059}" FontWeight="SemiBold" Margin="0,20,0,8"/>
              <TextBlock Text="{Binding Text, ElementName=DetectionStatus}" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding Text, ElementName=DetectedGameText}" TextWrapping="Wrap" Margin="0,8"/>
              <TextBlock Text="{Binding Text, ElementName=DetectionDiagnostics}" TextWrapping="Wrap"/>
              <TextBlock Text="{local:Tr Ui060}" TextWrapping="Wrap" Foreground="{Binding ConfigurationSecondaryForeground, Source={x:Static local:Appearance.Current}}" Margin="0,20"/>
          </StackPanel></ScrollViewer>
      </TabItem>
    </TabControl>
</Window>
