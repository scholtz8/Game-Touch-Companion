<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ControlTemplate x:Key="RoundedTouchButtonTemplate" TargetType="Button">
  <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="10" BorderBrush="#64748B" BorderThickness="1">
   <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
  </Border>
  <ControlTemplate.Triggers>
   <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.62"/></Trigger>
   <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.75"/></Trigger>
  </ControlTemplate.Triggers>
 </ControlTemplate>
 <ControlTemplate x:Key="ToolbarImageButtonTemplate" TargetType="Button">
  <Border x:Name="ImageSurface" Background="Transparent" CornerRadius="8">
   <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
  </Border>
  <ControlTemplate.Triggers>
   <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ImageSurface" Property="Background" Value="#25334155"/></Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ImageSurface" Property="Opacity" Value="0.58"/></Trigger>
   <Trigger Property="IsPressed" Value="True"><Setter TargetName="ImageSurface" Property="Opacity" Value="0.65"/></Trigger>
  </ControlTemplate.Triggers>
 </ControlTemplate>
</ResourceDictionary>
