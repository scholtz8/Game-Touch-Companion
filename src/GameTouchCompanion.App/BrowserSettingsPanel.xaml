<UserControl x:Class="GameTouchCompanion.App.BrowserSettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:local="clr-namespace:GameTouchCompanion.App"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">
            <TextBlock Text="{local:Tr Ui079}" FontSize="26" FontWeight="SemiBold"/>
            <Border Margin="0,12,0,0" Padding="14" Background="{Binding ConfigurationError, Source={x:Static local:Appearance.Current}}" CornerRadius="6"
                    Visibility="{Binding HasSettingsError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding SettingsError}" TextWrapping="Wrap" Foreground="{Binding ConfigurationErrorForeground, Source={x:Static local:Appearance.Current}}"/>
            </Border>
            <TextBlock Margin="0,8,0,20" TextWrapping="Wrap"
                       Text="{local:Tr Ui080}"/>
            <Label Content="{local:Tr Ui081}" Target="{Binding ElementName=AddressInput}" Padding="0,0,0,6"/>
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Margin="10,0,0,0" Padding="24,10" Content="{local:Tr Ui082}" Click="Navigate_Click"/>
                <TextBox x:Name="AddressInput" MinHeight="42" VerticalContentAlignment="Center" Padding="10,4"
                         Text="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="Address_KeyDown"/>
            </DockPanel>
            <Label Content="{local:Tr BrowserFavoriteTitleLabel}" Target="{Binding ElementName=FavoriteTitleInput}" Padding="0,12,0,6"/>
            <TextBox x:Name="FavoriteTitleInput" MinHeight="42" VerticalContentAlignment="Center" Padding="10,4" MaxLength="120"
                     Text="{Binding FavoriteTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="{local:Tr BrowserFavoriteTitleHelp}" TextWrapping="Wrap"
                       Foreground="{Binding ConfigurationSecondaryForeground, Source={x:Static local:Appearance.Current}}" Margin="0,4,0,0"/>
            <WrapPanel Margin="0,12,0,0">
                <Button Content="{local:Tr Ui085}" Padding="16,10" Margin="0,0,10,10" Click="SetHome_Click" IsEnabled="{Binding CanEditSettings}"/>
                <Button Content="{Binding FavoriteActionText}" Padding="16,10" Margin="0,0,10,10" Click="FavoriteAction_Click" IsEnabled="{Binding CanEditSettings}"/>
                <Button Content="{local:Tr BrowserCancelFavoriteEdit}" Padding="16,10" Margin="0,0,0,10"
                        Click="CancelFavoriteEdit_Click"
                        Visibility="{Binding IsEditingFavorite, Converter={StaticResource BoolToVisibility}}"/>
            </WrapPanel>
            <TextBlock Margin="0,6" TextWrapping="Wrap">
                <Run Text="{local:Tr Ui087}"/><Run Text="{Binding HomeUrl, Mode=OneWay}"/>
            </TextBlock>
            <TextBlock Margin="0,6" TextWrapping="Wrap">
                <Run Text="{local:Tr Ui088}"/><Run Text="{Binding CurrentUrl, Mode=OneWay}"/>
            </TextBlock>

            <TextBlock Text="{local:Tr BrowserZoomHeading}" FontWeight="SemiBold" FontSize="20" Margin="0,20,0,10"/>
            <TextBlock Text="{local:Tr BrowserDefaultZoomLabel}" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="−" Width="46" Height="40" Padding="0" Margin="0,0,8,0"
                        Click="DefaultZoomOut_Click" IsEnabled="{Binding CanDecreaseDefaultZoom}"/>
                <Border MinWidth="76" Height="40" Padding="12,0" BorderThickness="1" CornerRadius="6"
                        Background="{Binding ConfigurationControl, Source={x:Static local:Appearance.Current}}" BorderBrush="{Binding ConfigurationBorder, Source={x:Static local:Appearance.Current}}">
                    <TextBlock Text="{Binding DefaultZoomText}" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                </Border>
                <Button Content="+" Width="46" Height="40" Padding="0" Margin="8,0,0,0"
                        Click="DefaultZoomIn_Click" IsEnabled="{Binding CanIncreaseDefaultZoom}"/>
            </StackPanel>
            <TextBlock Text="{local:Tr BrowserDefaultZoomHelp}" TextWrapping="Wrap"
                       Foreground="{Binding ConfigurationSecondaryForeground, Source={x:Static local:Appearance.Current}}" Margin="0,6,0,10"/>
            <CheckBox Content="{local:Tr BrowserRememberZoomPerSite}"
                      IsChecked="{Binding RememberZoomPerSite, Mode=OneWay}"
                      IsEnabled="{Binding CanEditSettings}"
                      Click="RememberZoomPerSite_Click"
                      Margin="0,0,0,4"/>
            <TextBlock Text="{local:Tr BrowserRememberZoomPerSiteHelp}" TextWrapping="Wrap"
                       Foreground="{Binding ConfigurationSecondaryForeground, Source={x:Static local:Appearance.Current}}"
                       Margin="24,0,0,6"/>

            <TextBlock Text="{local:Tr BrowserNewWindowsHeading}" FontWeight="SemiBold" FontSize="20" Margin="0,20,0,10"/>
            <CheckBox x:Name="OpenNewWindowsInTabs"
                      Content="{local:Tr BrowserOpenNewWindowsInTabs}"
                      IsChecked="{Binding OpenNewWindowsInTabs, Mode=OneWay}"
                      IsEnabled="{Binding CanEditSettings}"
                      Click="OpenNewWindowsInTabs_Click"
                      Margin="0,0,0,4"/>
            <TextBlock Text="{local:Tr BrowserOpenNewWindowsInTabsHelp}"
                       TextWrapping="Wrap"
                       Foreground="{Binding ConfigurationSecondaryForeground, Source={x:Static local:Appearance.Current}}"
                       Margin="24,0,0,10"/>
            <CheckBox x:Name="ActivateNewWindowTabs"
                      Content="{local:Tr BrowserActivateNewWindowTabs}"
                      IsChecked="{Binding ActivateNewWindowTabs, Mode=OneWay}"
                      IsEnabled="{Binding CanEditNewWindowActivation}"
                      Click="ActivateNewWindowTabs_Click"
                      Margin="0,0,0,4"/>
            <TextBlock Text="{local:Tr BrowserActivateNewWindowTabsHelp}"
                       TextWrapping="Wrap"
                       Foreground="{Binding ConfigurationSecondaryForeground, Source={x:Static local:Appearance.Current}}"
                       Margin="24,0,0,6"/>
            <TextBlock Text="{local:Tr Ui090}" FontWeight="SemiBold" FontSize="20" Margin="0,18,0,10"/>
            <ListBox x:Name="FavoritesList" ItemsSource="{Binding Favorites}" SelectedItem="{Binding SelectedFavorite, Mode=TwoWay}"
                     MinHeight="90" MaxHeight="190" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Height" Value="48"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <TextBlock Text="{Binding DisplayText}"
                                       Margin="10,0"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding DisplayText}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <WrapPanel Margin="0,10,0,12">
                <Button Content="{local:Tr Ui091}" Padding="16,8" Margin="0,0,10,0" Click="OpenFavorite_Click"/>
                <Button Content="{local:Tr BrowserEditFavorite}" Padding="16,8" Margin="0,0,10,0"
                        Click="EditFavorite_Click" IsEnabled="{Binding CanEditSelectedFavorite}"/>
                <Button Content="{local:Tr Ui092}" Padding="16,8" Click="RemoveFavorite_Click" IsEnabled="{Binding CanEditSelectedFavorite}"/>
            </WrapPanel>
            <!-- Passive browser status is logged in the background. Only errors remain visible. -->
            <Border Margin="0,12,0,0" Padding="14" Background="{Binding ConfigurationError, Source={x:Static local:Appearance.Current}}" CornerRadius="6"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{Binding ConfigurationErrorForeground, Source={x:Static local:Appearance.Current}}"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
