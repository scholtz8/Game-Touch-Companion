<UserControl x:Class="GameTouchCompanion.App.BrowserSettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:local="clr-namespace:GameTouchCompanion.App"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">
            <TextBlock Text="{local:Tr Ui079}" FontSize="26" FontWeight="SemiBold"/>
            <Border Margin="0,12,0,0" Padding="14" Background="{Binding ConfigurationError, Source={x:Static local:Appearance.Current}}" CornerRadius="6"
                    Visibility="{Binding HasSettingsError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding SettingsError}" TextWrapping="Wrap" Foreground="{Binding ConfigurationErrorForeground, Source={x:Static local:Appearance.Current}}"/>
            </Border>
            <TextBlock Margin="0,8,0,20" TextWrapping="Wrap"
                       Text="{local:Tr Ui080}"/>
            <Label Content="{local:Tr Ui081}" Target="{Binding ElementName=AddressInput}" Padding="0,0,0,6"/>
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Margin="10,0,0,0" Padding="24,10" Content="{local:Tr Ui082}" Click="Navigate_Click"/>
                <TextBox x:Name="AddressInput" MinHeight="42" VerticalContentAlignment="Center" Padding="10,4"
                         Text="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="Address_KeyDown"/>
            </DockPanel>
            <WrapPanel Margin="0,12,0,0">
                <Button Content="{local:Tr Ui083}" Padding="16,10" Margin="0,0,10,10" Click="Open_Click"/>
                <Button Content="{local:Tr Ui084}" Padding="16,10" Margin="0,0,10,10" Click="LocalPage_Click"/>
                <Button Content="{local:Tr Ui085}" Padding="16,10" Margin="0,0,10,10" Click="SetHome_Click" IsEnabled="{Binding CanEditSettings}"/>
                <Button Content="{local:Tr Ui086}" Padding="16,10" Margin="0,0,0,10" Click="AddFavorite_Click" IsEnabled="{Binding CanEditSettings}"/>
            </WrapPanel>
            <TextBlock Margin="0,6" TextWrapping="Wrap">
                <Run Text="{local:Tr Ui087}"/><Run Text="{Binding HomeUrl, Mode=OneWay}"/>
            </TextBlock>
            <TextBlock Margin="0,6" TextWrapping="Wrap">
                <Run Text="{local:Tr Ui088}"/><Run Text="{Binding CurrentUrl, Mode=OneWay}"/>
            </TextBlock>
            <CheckBox x:Name="ToolbarCheck" Content="{local:Tr Ui089}" Margin="0,12"
                      IsChecked="{Binding ShowToolbar, Mode=OneWay}" Click="Toolbar_Click"/>
            <TextBlock Text="{local:Tr Ui090}" FontWeight="SemiBold" FontSize="20" Margin="0,18,0,10"/>
            <ListBox x:Name="FavoritesList" ItemsSource="{Binding Favorites}" SelectedItem="{Binding SelectedFavorite, Mode=TwoWay}"
                     MinHeight="90" MaxHeight="190" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="6">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Url}" Foreground="{Binding ConfigurationSecondaryForeground, Source={x:Static local:Appearance.Current}}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <WrapPanel Margin="0,10,0,12">
                <Button Content="{local:Tr Ui091}" Padding="16,8" Margin="0,0,10,0" Click="OpenFavorite_Click"/>
                <Button Content="{local:Tr Ui092}" Padding="16,8" Click="RemoveFavorite_Click" IsEnabled="{Binding CanEditSettings}"/>
            </WrapPanel>
            <!-- Passive browser status is logged in the background. Only errors remain visible. -->
            <Border Margin="0,12,0,0" Padding="14" Background="{Binding ConfigurationError, Source={x:Static local:Appearance.Current}}" CornerRadius="6"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{Binding ConfigurationErrorForeground, Source={x:Static local:Appearance.Current}}"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
