<Window x:Class="FocusProbe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Focus Probe" Height="560" Width="680" KeyDown="Window_KeyDown">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock FontSize="30" FontWeight="Bold" Text="FOCUS PROBE"/>
        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
            <TextBlock Text="Process ID"/><TextBlock x:Name="PidText" Grid.Column="1" FontFamily="Consolas"/>
            <TextBlock Grid.Row="1" Text="HWND"/><TextBlock x:Name="HwndText" Grid.Row="1" Grid.Column="1" FontFamily="Consolas"/>
            <TextBlock Grid.Row="2" Text="Foreground HWND"/><TextBlock x:Name="ForegroundText" Grid.Row="2" Grid.Column="1" FontFamily="Consolas"/>
            <TextBlock Grid.Row="3" Text="STATE"/><TextBlock x:Name="StateText" Grid.Row="3" Grid.Column="1" FontWeight="Bold"/>
            <TextBlock Grid.Row="4" Text="Focus losses"/><TextBlock x:Name="LossText" Grid.Row="4" Grid.Column="1" FontSize="24" FontWeight="Bold"/>
            <TextBlock Grid.Row="5" Text="Last event"/><TextBlock x:Name="EventText" Grid.Row="5" Grid.Column="1" FontFamily="Consolas"/>
        </Grid>
        <Border Grid.Row="2" Margin="0,22" Padding="18" Background="#FFE2E8F0" CornerRadius="8">
            <StackPanel><TextBlock Text="SPACE COUNTER" FontWeight="Bold"/><TextBlock x:Name="CounterText" FontSize="44" Text="0"/></StackPanel>
        </Border>
        <TextBlock Grid.Row="3" Margin="0,0,0,8" Text="Foreground timeline" FontWeight="SemiBold"/>
        <ListBox x:Name="Timeline" Grid.Row="4" FontFamily="Consolas"/>
    </Grid>
</Window>
